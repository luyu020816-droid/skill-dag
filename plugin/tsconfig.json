{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": "lib",
    "declaration": true,
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
