{
  "name": "skill-dag-dsh",
  "version": "0.1.0",
  "description": "GraSP skill DAG compiler for DeepSeek Harness: compile real session+workspace skills into typed executable DAGs (state/data/order edges) with LLM-inferred predicates (no manual annotation), goal-aware proposing, verification and bounded local repair. Inline SVG in the tool card.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown && node scripts/normalize-client-banner.mjs",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "grasp",
    "skill",
    "dag",
    "planning",
    "agent"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.5"
  },
  "dependencies": {
    "skill-dag": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourname/skill-dag.git"
  },
  "license": "MIT"
}
